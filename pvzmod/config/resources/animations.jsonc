        "walk2": { "track": "anim_walk2", "loop": "loop", "rate": 12, "blendFrames": 0 },
        "walk": { "track": "anim_walk", "loop": "loop", "rate": 12, "blendFrames": 0 },
        "idle2": { "track": "anim_idle2", "loop": "loop", "rate": 12, "blendFrames": 0 },
