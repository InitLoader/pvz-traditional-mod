        "eat": { "track": "anim_eat", "loop": "loop", "rate": 12, "blendFrames": 0 },
        "waterdeath": { "track": "anim_waterdeath", "loop": "once_hold", "rate": 12, "blendFrames": 0 },
        "dance": { "track": "anim_dance", "loop": "loop", "rate": 12, "blendFrames": 0 },
        "innerarm3": { "track": "anim_innerarm3", "loop": "once", "rate": 12, "blendFrames": 0 },
