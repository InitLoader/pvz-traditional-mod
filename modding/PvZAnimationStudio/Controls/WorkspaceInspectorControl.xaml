<UserControl x:Class="PvZAnimationStudio.Controls.WorkspaceInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="5">
      <GroupBox Header="当前关键帧属性">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*" MinWidth="120"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="X 位移"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentX, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="1" Text="Y 位移"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentY, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="2" Text="X 旋转轴"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentSkewX, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="3" Text="Y 旋转轴"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentSkewY, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="4" Text="X 缩放"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentScaleX, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="5" Text="Y 缩放"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentScaleY, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="6" Text="图片子帧 f"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CurrentVisibilityFrame, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="7" Text="透明度"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CurrentAlpha, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="8" Text="图片符号"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding CurrentImage, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="9" Text="文字"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding CurrentText, UpdateSourceTrigger=LostFocus}"/>
        </Grid>
      </GroupBox>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="◆ 设置 K 帧" Click="SetKey_Click"/><Button Content="清除 K 帧" Click="ClearKey_Click"/>
      </StackPanel>
      <GroupBox Header="选中动作">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*" MinWidth="120"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="动作 ID"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedActionId, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="1" Text="中文名"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedActionDisplayName, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="2" Text="标记轨道"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedActionTrack, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="3" Text="循环"/><ComboBox x:Name="LoopCombo" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding SelectedActionLoop, Mode=TwoWay}"/>
          <TextBlock Grid.Row="4" Text="速度"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedActionRate, UpdateSourceTrigger=LostFocus}"/>
          <TextBlock Grid.Row="5" Text="混合帧"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedActionBlendFrames, UpdateSourceTrigger=LostFocus}"/>
        </Grid>
      </GroupBox>
      <GroupBox Header="植物 / 僵尸配置">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*" MinWidth="120"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="数字 ID"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectNumericEntityId}"/>
          <TextBlock Grid.Row="1" Text="模板 ID"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProjectTemplateEntityId}"/>
          <TextBlock Grid.Row="2" Text="阳光"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProjectCost}"/>
          <TextBlock Grid.Row="3" Text="冷却"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProjectRechargeTime}"/>
          <TextBlock Grid.Row="4" Text="生命"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProjectHealth}"/>
          <TextBlock Grid.Row="5" Text="攻击间隔"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProjectLaunchRate}"/>
          <TextBlock Grid.Row="6" Text="子弹类型"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ProjectProjectileType}"/>
          <TextBlock Grid.Row="7" Text="伤害"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ProjectDamage}"/>
          <TextBlock Grid.Row="8" Text="每次发射"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ProjectShotsPerAttack}"/>
        </Grid>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
