<UserControl x:Class="PvZAnimationStudio.Controls.WorkspaceBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TabControl>
    <TabItem Header="轨道">
      <DockPanel Margin="5">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
          <Button Content="＋ 轨道" Click="AddTrack_Click" />
          <Button Content="－ 轨道" Click="RemoveTrack_Click" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Width="25" Height="22" Margin="0,0,5,0" Padding="0"
                        Tag="{Binding}" Click="TrackVisibility_Click" ToolTip="仅在编辑器预览中显示或隐藏该轨道">
                  <TextBlock Text="{Binding EditorVisibilityGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Left" Width="25" Height="22" Margin="0,0,5,0" Padding="0"
                        Tag="{Binding}" Click="TrackLock_Click" ToolTip="锁定后禁止修改、移动或删除该轨道的关键帧">
                  <TextBlock Text="{Binding EditorLockGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Border DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,6,0"
                        Background="#222B34" BorderBrush="#536171" BorderThickness="1"
                        ToolTip="{Binding EditorImageSymbol}">
                  <Image Source="{Binding EditorThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </TabItem>
    <TabItem Header="动作">
      <DockPanel Margin="5">
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="显示完整时间轴" Click="FullTimeline_Click" ToolTip="退出动作局部视图" />
          <ComboBox x:Name="ActionTemplateCombo" ItemsSource="{Binding ActionTemplates}" DisplayMemberPath="ChineseName" />
          <StackPanel Orientation="Horizontal">
            <Button Content="添加模板" Click="AddAction_Click" />
            <Button Content="删除动作" Click="RemoveAction_Click" />
          </StackPanel>
          <Button Content="重新识别全部 anim_* 动作" Click="InferActions_Click" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" DisplayMemberPath="Summary" />
      </DockPanel>
    </TabItem>
    <TabItem Header="图片资源">
      <DockPanel Margin="5">
        <Button DockPanel.Dock="Bottom" Content="导入 PNG / JPG 图片" Click="ImportImages_Click" />
        <ListBox x:Name="ImageBindingsList" ItemsSource="{Binding Project.ImageBindings}" DisplayMemberPath="Key"
                 MouseDoubleClick="ImageBindingsList_MouseDoubleClick" />
      </DockPanel>
    </TabItem>
    <TabItem Header="工程">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="7">
          <TextBlock Text="实体类型" /><ComboBox x:Name="KindCombo" SelectedItem="{Binding ProjectKind, Mode=TwoWay}" />
          <TextBlock Text="字符串 ID" /><TextBox Text="{Binding ProjectId, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="中文名称" /><TextBox Text="{Binding ProjectDisplayName, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="介绍" /><TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=LostFocus}" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
          <TextBlock Text="载体 Reanimation" /><TextBox Text="{Binding ProjectCarrierReanimation, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="默认导出格式" /><ComboBox x:Name="OutputFormatCombo" SelectedItem="{Binding ProjectOutputFormat, Mode=TwoWay}" />
          <TextBlock Text="游戏根目录" /><TextBox Text="{Binding ProjectGameRoot, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" />
          <Button Content="选择游戏目录" Click="ChooseGameRoot_Click" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
