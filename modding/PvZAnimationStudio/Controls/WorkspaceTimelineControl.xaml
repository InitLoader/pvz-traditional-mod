<UserControl x:Class="PvZAnimationStudio.Controls.WorkspaceTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PvZAnimationStudio.Controls">
  <DockPanel Background="#181D24">
    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Margin="4">
        <Button Content="|◀" Click="FirstFrame_Click"/><Button Content="◀" Click="PreviousFrame_Click"/>
        <Button Content="▶" Click="NextFrame_Click"/><Button Content="▶|" Click="LastFrame_Click"/>
        <TextBlock Text="{Binding FrameLabel}" Margin="12,7"/>
        <Button Content="插入整帧" Click="InsertFrame_Click"/><Button Content="删除整帧" Click="DeleteFrame_Click"/>
        <Separator Margin="5,0"/>
        <Button Content="◀ 关键帧" ToolTip="将当前轨道关键帧左移一帧（Shift+←）" Click="MoveKeyLeft_Click"/>
        <Button Content="关键帧 ▶" ToolTip="将当前轨道关键帧右移一帧（Shift+→）" Click="MoveKeyRight_Click"/>
        <Button Content="删除关键帧" ToolTip="只删除当前轨道当前时刻的关键帧（Delete）" Click="DeleteKey_Click"/>
        <Button Content="复制关键帧" ToolTip="复制框选关键帧；未框选时复制当前关键帧（Ctrl+C）" Click="CopyKeys_Click"/>
        <Button Content="复制轨道" ToolTip="复制当前动作范围内本轨道的全部关键帧" Click="CopyTrackKeys_Click"/>
        <Button Content="粘贴关键帧" ToolTip="以当前帧为起点粘贴到当前轨道（Ctrl+V）" Click="PasteKeys_Click"/>
        <Button Content="复制整轨+图片" ToolTip="复制整条轨道、全部曲线和图片资源，可跨动画粘贴" Click="CopyWholeTrack_Click"/>
        <Button Content="粘贴为新轨道" ToolTip="在当前动画创建第二条独立轨道和独立图片绑定" Click="PasteWholeTrack_Click"/>
        <Button Content="显示完整时间轴" Click="FullTimeline_Click"/>
        <TextBlock Text="FPS" Margin="12,7,2,7"/><TextBox Width="90" Text="{Binding AnimationFps, UpdateSourceTrigger=LostFocus}"/>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <controls:TimelineControl x:Name="Timeline"/>
    </ScrollViewer>
  </DockPanel>
</UserControl>
