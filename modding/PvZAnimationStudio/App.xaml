<Application x:Class="PvZAnimationStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#20262E" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#45515F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#69D26F" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C2CC" />

    <Style TargetType="Window">
      <Setter Property="Background" Value="#151A20" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="#34404C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#607080" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#242B33" />
          <Setter Property="Foreground" Value="#84909B" />
          <Setter Property="BorderBrush" Value="#3B4651" />
          <Setter Property="Opacity" Value="0.8" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="ToolTipService.ShowDuration" Value="20000" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2D7441" />
      <Setter Property="BorderBrush" Value="#70D487" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="#10151B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CaretBrush" Value="#FFFFFF" />
      <Setter Property="SelectionBrush" Value="#4677A8" />
      <Setter Property="BorderBrush" Value="#596776" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="Background" Value="#F1F4F7" />
      <Setter Property="Foreground" Value="#111820" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#12171D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#45515F" />
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#303A45" />
      <Setter Property="Padding" Value="9,4" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A5A69" />
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#536171" />
    </Style>
    <Style TargetType="Menu">
      <Setter Property="Background" Value="#252D36" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#252D36" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </Application.Resources>
</Application>
