<Application x:Class="PvZAnimationStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#20262E" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#45515F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#69D26F" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C2CC" />

    <Style TargetType="Window">
      <Setter Property="Background" Value="#151A20" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Background" Value="#34404C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#607080" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#242B33" />
          <Setter Property="Foreground" Value="#84909B" />
          <Setter Property="BorderBrush" Value="#3B4651" />
          <Setter Property="Opacity" Value="0.8" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="ToolTipService.ShowDuration" Value="20000" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2D7441" />
      <Setter Property="BorderBrush" Value="#70D487" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="#10151B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CaretBrush" Value="#FFFFFF" />
      <Setter Property="SelectionBrush" Value="#4677A8" />
      <Setter Property="BorderBrush" Value="#596776" />
    </Style>
    <ControlTemplate x:Key="DarkComboToggleTemplate" TargetType="ToggleButton">
      <Border x:Name="ToggleBorder" Background="#29333E" BorderBrush="#5D6C7B" BorderThickness="1" CornerRadius="4">
        <Grid>
          <Border HorizontalAlignment="Right" Width="28" Background="#34414D" CornerRadius="0,4,4,0" />
          <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                Data="M 0 0 L 8 0 L 4 5 Z" Fill="#D7E0E8" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7BCB96" />
          <Setter TargetName="ToggleBorder" Property="Background" Value="#303D48" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#69D26F" />
          <Setter TargetName="ToggleBorder" Property="Background" Value="#263B31" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="ToggleBorder" Property="Background" Value="#20272F" />
          <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#394550" />
          <Setter TargetName="Arrow" Property="Fill" Value="#77838E" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="29" />
      <Setter Property="Padding" Value="8,4,34,4" />
      <Setter Property="Background" Value="#29333E" />
      <Setter Property="Foreground" Value="#EEF3F6" />
      <Setter Property="BorderBrush" Value="#5D6C7B" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                            Template="{StaticResource DarkComboToggleTemplate}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter x:Name="SelectedContent" IsHitTestVisible="False"
                                Margin="9,4,34,4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="340" Background="#202831" BorderBrush="#617181" BorderThickness="1" CornerRadius="5">
                  <ScrollViewer Margin="3" CanContentScroll="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="PART_Popup" Property="MinHeight" Value="60" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SelectedContent" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#EAF0F4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#365244" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#2E6A49" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#78848E" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#12171D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#45515F" />
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#303A45" />
      <Setter Property="Padding" Value="9,4" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#4A5A69" />
          <Setter Property="Foreground" Value="#FFFFFF" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="6" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#536171" />
    </Style>
    <Style TargetType="Menu">
      <Setter Property="Background" Value="#252D36" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#252D36" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </Application.Resources>
</Application>
